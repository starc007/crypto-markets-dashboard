# Free CoinGecko Demo key: https://www.coingecko.com/en/developers/dashboard
# Optional for local development (the keyless public API is used without it,
# with lower and less predictable rate limits). Never prefix with NEXT_PUBLIC_.
COINGECKO_API_KEY=

# How long a market snapshot is served before the server refreshes it.
# 300s keeps a single always-on instance inside the 10,000 calls/month Demo quota
# (see DECISIONS.md). Values below 60 are rejected.
MARKETS_REFRESH_INTERVAL_SECONDS=300
